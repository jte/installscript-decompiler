// Cloudflare deployment config: serves the static site in dist/ (built by
// `npm run build`). Deploy with `npm run deploy`.
{
  "name": "installscript-decompiler",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./dist"
  },
  // Served at the installscript-decompiler.com zone in the same Cloudflare
  // account; deploying creates the DNS records and certificates. A redirect
  // rule in the dashboard sends www to the apex before the Worker runs.
  "routes": [
    { "pattern": "installscript-decompiler.com", "custom_domain": true },
    { "pattern": "www.installscript-decompiler.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": false
  }
}
