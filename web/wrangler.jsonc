// Cloudflare deployment config: serves the static site in dist/ (built by
// `npm run build`). Deploy with `npm run deploy`.
{
  "name": "installscript-decompiler",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./dist"
  },
  // Served at the apex of the installscript-decompiler.com zone in the same
  // Cloudflare account; deploying creates the DNS record and certificate.
  "routes": [
    { "pattern": "installscript-decompiler.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": false
  }
}
