#include "debug_inc.h"

typedef POINT
begin
    NUMBER x;
    NUMBER y;
end;

NUMBER gCount;
STRING gName[32];

prototype NUMBER First(NUMBER, STRING);
prototype Locals(STRING, VARIANT);

function NUMBER First(nParam, szParam)
    NUMBER nLocal;
    STRING szLocal;
begin
    nLocal = nParam + 1;
    szLocal = szParam;
    Helper(nLocal);
    return nLocal;
end;

function Locals(szA, vA)
    STRING szSized[20];
    POINT pt;
    NUMBER nArr(3);
begin
    szSized = szA;
    pt.x = 1;
    nArr(0) = pt.x;
    vA = nArr(0);
end;

program
    gCount = First(1, gName);
    Locals("a", 1);
endprogram
